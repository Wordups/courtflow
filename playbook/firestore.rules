rules_version = '2';

// Millers Playbook. Paste into Firebase console > Firestore Database > Rules > Publish.
// Only the shared coach account can read or write practice plans and the roster.
// The player account (and anyone not signed in) gets nothing from the database.
service cloud.firestore {
  match /databases/{database}/documents {
    function isCoach() {
      return request.auth != null && request.auth.token.email == 'coaches@mma.team';
    }

    match /plans/{planId} {
      allow read, write: if isCoach();
    }

    match /roster/{playerId} {
      allow read, write: if isCoach();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
