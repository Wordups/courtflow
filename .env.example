ENVIRONMENT=development
APP_VERSION=0.2.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
SUPABASE_JWT_AUDIENCE=authenticated
STORAGE_BUCKET=boxscores
MAX_UPLOAD_BYTES=8388608
ALLOWED_UPLOAD_MIME=image/jpeg,image/png,image/webp

AI_PROVIDER=disabled
AI_MODEL=provider-model-name
AI_API_KEY=server-only-provider-key
BOX_SCORE_PROVIDER=disabled
BOX_SCORE_MODEL=provider-vision-model-name
BOX_SCORE_API_KEY=server-only-provider-key
